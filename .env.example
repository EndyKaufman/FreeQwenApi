# Telegram уведомления и бот
# Получите токен бота у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID пользователей Telegram (через запятую)
# Чтобы узнать свой ID, напишите боту @userinfobot
TELEGRAM_USER_IDS=123456789,987654321

# Время предупреждения об истечении токена в миллисекундах (по умолчанию 1 час = 3600000)
TOKEN_EXPIRY_WARNING_MS=3600000

# Telegram прокси (опционально)
# Используйте если Telegram API заблокирован в вашем регионе
# Поддерживаемые протоколы: http, https, socks4, socks5
# TELEGRAM_PROXY=http://proxy.example.com:8080
# TELEGRAM_PROXY=http://username:password@proxy.example.com:8080
# TELEGRAM_PROXY=socks5://proxy.example.com:1080

# Таймаут для Telegram запросов в миллисекундах (по умолчанию 5 минут = 300000)
# Увеличьте при медленном соединении или использовании прокси
# TELEGRAM_TIMEOUT=300000

# Qwen LLM прокси (опционально)
# Используйте для доступа к Qwen API через прокси
# Поддерживаемые протоколы: http, https, socks, socks5
# QWEN_PROXY=http://proxy.example.com:8080
# QWEN_PROXY=http://username:password@proxy.example.com:8080
# QWEN_PROXY=socks5://proxy.example.com:1080

# Прокси для скачивания файлов по HTTP/HTTPS (опционально)
# Используется когда API получает URLs файлов которые нужно скачать
# Поддерживаемые протоколы: http, https, socks4, socks5
# FILE_DOWNLOAD_PROXY=http://proxy.example.com:8080
# FILE_DOWNLOAD_PROXY=http://username:password@proxy.example.com:8080
# FILE_DOWNLOAD_PROXY=socks5://proxy.example.com:1080

# Прокси для проверки обновлений (опционально)
# Используется для запросов к Docker Hub, npm registry, GitHub
# Поддерживаемые протоколы: http, https, socks4, socks5
# VERSION_CHECK_PROXY=http://proxy.example.com:8080
# VERSION_CHECK_PROXY=http://username:password@proxy.example.com:8080
# VERSION_CHECK_PROXY=socks5://proxy.example.com:1080

# Модель по умолчанию для LLM чата
# DEFAULT_MODEL=qwen-max-latest

# ─── Режим сессий чата ──────────────────────────────────────────────────────
# FORCE_NEW_CHAT_PER_REQUEST=true: каждый запрос создает новый диалог (как OpenAI API)
# FORCE_NEW_CHAT_PER_REQUEST=false (по умолчанию): восстанавливает предыдущий диалог
# FORCE_NEW_CHAT_PER_REQUEST=true

# ─── Генерация изображений ──────────────────────────────────────────────────
# Режим генерации изображений:
# 'dashscope' (по умолчанию) - использует DASHSCOPE_API_KEY напрямую
# 'browser' - использует браузер через Qwen Chat API (как генерация текста)
IMAGE_GENERATION_MODE=browser

# DashScope API ключ (требуется при IMAGE_GENERATION_MODE=dashscope)
# Получить: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ─── Проверка обновлений ──────────────────────────────────────────────────────
# Автоматическая проверка обновлений (Docker Hub, npm, GitHub)
# true (по умолчанию): проверять каждый час, уведомлять в Telegram раз в сутки днем
# false: проверка отключена
# ENABLE_VERSION_CHECK=false

# ─── Puppeteer консоль браузера ──────────────────────────────────────────────
# Показывать ошибки и варнинги из вкладок браузера в консоли Node.js
# true (по умолчанию): показывать BROWSER ERROR и BROWSER WARNING
# false: отключить вывод консоли браузера
# PUPPETEER_CONSOLE_LOGS=false

# ─── Puppeteer протокол ─────────────────────────────────────────────────────
# Таймаут протокола Puppeteer для всех операций page.evaluate() (в миллисекундах)
# 120000 (по умолчанию) = 2 минуты
# PUPPETEER_PROTOCOL_TIMEOUT=120000

# ─── Puppeteer запись экрана (Screencast) ────────────────────────────────────
# Автоматическая запись экрана вкладки если page.evaluate() не завершился за указанное время
# Указывается в миллисекундах (40000 = 40 секунд)
# Записи сохраняются в logs/screencasts/ в формате WebM
# 0 (по умолчанию): запись отключена
# ТРЕБОВАНИЕ: должен быть установлен ffmpeg
#   Ubuntu/Debian: sudo apt-get install ffmpeg
#   macOS: brew install ffmpeg
#   Docker: уже включен в образ
# PAGE_EVALUATE_SCREENCAST_TIMEOUT=40000

# Максимальная длительность записи экрана (в миллисекундах)
# Если запись началась, она автоматически остановится через указанное время
# 60000 = 60 секунд, 120000 = 2 минуты
# 0 (по умолчанию): без ограничений (запись остановится когда завершится page.evaluate())
# PAGE_EVALUATE_SCREENCAST_MAX_DURATION=60000

# ─── Puppeteer симуляция движений мыши ───────────────────────────────────────
# Симуляция случайных движений мыши после создания вкладки браузера
# Делает поведение браузера более "человечным" для обхода анти-бот систем
# Указывается в миллисекундах (2000 = 2 секунды)
# 0 (по умолчанию): симуляция отключена
# MOUSE_MOVEMENT_DURATION=2000
